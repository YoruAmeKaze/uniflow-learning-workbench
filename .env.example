# UniFlow 环境配置模板
# 复制为 .env 后填写真实值
DEBUG=true

# HTTP Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# 文件上传（AI 解析 PDF/TXT 等）
UPLOAD_MAX_MB=10

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=uniflow
DB_CHARSET=utf8mb4_general_ci

# JWT
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM (OpenAI Compatible)
# provider: openai（默认，云端 DeepSeek）| ollama（本地模型）
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 本地 Ollama 示例（LLM_PROVIDER=ollama 时生效）：
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b

# RAG 向量模型。推荐百炼：复用 LLM_API_KEY，不需要启动 Ollama。
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_API_KEY=  # 留空时自动复用 LLM_API_KEY

# 本地 Ollama 备选（需先执行：ollama pull nomic-embed-text）
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://127.0.0.1:11434
# EMBEDDING_MODEL=nomic-embed-text

# 学期校历：开学第 1 周周一日期（周课表据此推算当前周；YYYY-MM-DD）
SEMESTER_START=2026-09-07

# 数你最灵（smartestu.cn）作业平台
# 拉取作业时需提供账号密码，不在此配置
SMARTESTU_SCHOOL_CODE=cqupt

# 学习通（chaoxing）作业平台
# 默认启用；设为 false 可禁用。账号密码由作业页刷新时传入，不写入服务端环境变量。
CHAOXING_ENABLED=true
